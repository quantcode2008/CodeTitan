# ==============================================================================
# BrandProof — Environment Configuration
# ==============================================================================

# --- Supabase Configuration (Required) ---
# Your Supabase project URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anonymous API key (safe for client-side queries protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role secret key (SERVER ONLY - NEVER expose to browser client)
# Used exclusively in /lib/supabase/admin.ts guarded by "server-only"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- LLM Provider Configuration (Optional for Mock, Required for Live AI Lane) ---
# Google Gemini API Key for nuance/tone analysis and purpose-preserving suggestion generation
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# Optional model override (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# --- Deployment / Node Environment ---
NODE_ENV=development
PORT=3000
